local function fetchSource(relativeUrl)
	local sources = {
		"https://raw.githubusercontent.com/deividcomsono/Obsidian/main/" .. relativeUrl,
		"https://cdn.jsdelivr.net/gh/deividcomsono/Obsidian@main/" .. relativeUrl,
		"https://raw.githack.com/deividcomsono/Obsidian/main/" .. relativeUrl,
		"https://raw.githubusercontent.com/mstudio45/LinoriaLib/main/" .. relativeUrl
	}
	
	for _, url in ipairs(sources) do
		local success, response = pcall(function()
			return game:HttpGet(url)
		end)
		if success and response and #response > 0 and not response:find("404") then
			local loadSuccess, result = pcall(function()
				return loadstring(response)()
			end)
			if loadSuccess and result then
				return result
			end
		end
	end
	return nil
end

