-- Force Sharp Square Corners
local function MakeEverythingSquare(parent)
    if not parent then return end
    for _, obj in ipairs(parent:GetDescendants()) do
        if obj:IsA("UICorner") then
            obj.CornerRadius = UDim.new(0, 0)
        end
    end
end

